# คัดลอกเป็น .env.local แล้วใส่ค่าจริง
# local: ดูค่าจาก `npx supabase status` (API URL + publishable/anon key)
# production: Supabase dashboard > Project Settings > API
VITE_SUPABASE_URL=http://127.0.0.1:55321
VITE_SUPABASE_ANON_KEY=

# ลิงก์ที่ใส่ใน QR บนจอแสดงผล (ไม่ใส่ = ใช้ origin ของหน้าเว็บที่เปิดอยู่)
# ตั้งไว้เมื่อเปิดจอแสดงผลจาก localhost แต่ให้คนสแกนเข้าเว็บจริง
VITE_PUBLIC_SITE_URL=
